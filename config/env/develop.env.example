# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=develop
PORT=8080
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=text
DEFAULT_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=https://dev.cms.digimap.ai,https://dev.api.digimap.ai

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=digimap_develop
DB_USER=digimap
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=24h
JWT_ISSUER=digimap-backend

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=digimap-develop
SES_FROM_EMAIL=noreply@digimap.ai

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=
