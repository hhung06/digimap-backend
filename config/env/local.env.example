# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
PORT=8080
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text
DEFAULT_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=*

# ── Server timeouts ───────────────────────────────────────────────────────────
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digimap
DB_USER=digimap
DB_PASSWORD=password
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=local-secret-key-change-in-production
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=24h
JWT_ISSUER=digimap-backend

# ── AWS (optional for local) ──────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=digimap-local
SES_FROM_EMAIL=noreply@example.com
