# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
PORT=8080
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=text
DEFAULT_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=*

# ── Server timeouts ───────────────────────────────────────────────────────────
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digimap
DB_USER=digimap
DB_PASSWORD=password
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=local-secret-key-change-in-production
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=24h
JWT_ISSUER=digimap-backend

# ── AWS (optional for local) ──────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ASSETS_BUCKET=digimap-local-assets
AWS_S3_SNAPSHOT_BUCKET=digimap-local-snapshots
AWS_S3_SYNC_BUCKET=digimap-local-sync
AWS_CF_DISTRIBUTION_ID=
AWS_CF_ASSETS_DOMAIN=

# ── SMTP (optional for local) ─────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDR=noreply@example.com

# ── OpenSearch (optional for local) ──────────────────────────────────────────
OPENSEARCH_ENDPOINT=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── Firebase (optional for local) ────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ── Encryption keys ───────────────────────────────────────────────────────────
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
