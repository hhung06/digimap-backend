# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
PORT=8080
DEBUG=false
LOG_LEVEL=warn
LOG_FORMAT=json
DEFAULT_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=https://cms.digimap.ai,https://api.digimap.ai

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=digimap
DB_USER=digimap
DB_PASSWORD=
DB_SSLMODE=require
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=24h
JWT_ISSUER=digimap-backend

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=digimap-production
SES_FROM_EMAIL=noreply@digimap.ai

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=
