# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
PORT=8080
DEBUG=false
LOG_LEVEL=warn
LOG_FORMAT=json
DEFAULT_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=https://cms.digimap.ai,https://api.digimap.ai

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_NAME=digimap
DB_USER=digimap
DB_PASSWORD=
DB_SSLMODE=require
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=24h
JWT_ISSUER=digimap-backend

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ASSETS_BUCKET=digimap-production-assets
AWS_S3_SNAPSHOT_BUCKET=digimap-production-snapshots
AWS_S3_SYNC_BUCKET=digimap-production-sync
AWS_CF_DISTRIBUTION_ID=
AWS_CF_ASSETS_DOMAIN=

# ── SMTP ──────────────────────────────────────────────────────────────────────
EMAIL_HOST=email-smtp.ap-northeast-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDR=noreply@digimap.ai

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=

# ── Encryption keys ───────────────────────────────────────────────────────────
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=
