# Copy to .env.deploy and fill in real values.
# This file is sourced by deploy.sh and rollback.sh.
# NEVER commit .env.deploy to version control.

# ── Domain ─────────────────────────────────────────────────────────────────────
API_DOMAIN=api.example.com
TRAEFIK_DASHBOARD_HOST=traefik.example.com
PROMETHEUS_HOST=prometheus.example.com
GRAFANA_HOST=grafana.example.com
ACME_EMAIL=ops@example.com

# Traefik dashboard basic auth (generate with: htpasswd -nb admin yourpassword)
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$xyz...
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# ── Database ───────────────────────────────────────────────────────────────────
DB_NAME=digimap
DB_USER=digimap
DB_PASSWORD=change-me-strong-password
DB_SSLMODE=require

# ── App secrets ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-at-least-32-chars-long-secret
JWT_ISSUER=digimap

# ── AWS / S3 ───────────────────────────────────────────────────────────────────
S3_BUCKET=your-s3-bucket
S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ── Scaling ────────────────────────────────────────────────────────────────────
APP_REPLICAS=2
APP_CPU_LIMIT=1
APP_MEM_LIMIT=512M

# ── Deploy tuning ──────────────────────────────────────────────────────────────
HEALTH_TIMEOUT=120   # seconds to wait for new slot to be healthy
DRAIN_DELAY=30       # seconds to wait after cutover before draining old slot
