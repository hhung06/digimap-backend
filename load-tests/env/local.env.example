TARGET_BASE_URL=http://host.docker.internal:8080
PROFILE=normal
SCENARIO=public

# Use non-production credentials. Empty values exercise auth failure paths safely.
AUTH_TOKEN=
API_PUBLIC_KEY=
API_PRIVATE_KEY=

# Replace with IDs from the local/staging database for entity detail checks.
VENUE_ID=00000000-0000-0000-0000-000000000001
LOCATION_ID=00000000-0000-0000-0000-000000000002
PRODUCT_ID=00000000-0000-0000-0000-000000000003
SURVEY_ID=00000000-0000-0000-0000-000000000004

ALLOW_WRITES=false
ALLOW_PRODUCTION_LOAD_TEST=false
