TARGET_BASE_URL=https://staging-api.example.com
PROFILE=normal
SCENARIO=full

# Generate these from a staging user and staging venue only.
AUTH_TOKEN=replace-with-staging-jwt
API_PUBLIC_KEY=replace-with-staging-public-key
API_PRIVATE_KEY=replace-with-staging-private-key

VENUE_ID=replace-with-staging-venue-uuid
LOCATION_ID=replace-with-staging-location-uuid
PRODUCT_ID=replace-with-staging-product-uuid
SURVEY_ID=replace-with-staging-survey-uuid

ALLOW_WRITES=false
ALLOW_PRODUCTION_LOAD_TEST=false
